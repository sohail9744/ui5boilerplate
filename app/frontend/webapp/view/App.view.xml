<mvc:View
    controllerName="nadec.frontend.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:ff="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
>
    <App>
        <tnt:ToolPage id="toolPage">
            <tnt:header>
                <ff:ShellBar
                    title="Handling multiple apps"
                    secondTitle=""
                    showMenuButton="true"
                    homeIcon="./resources/sap/ui/documentation/sdk/images/logo_sap.png"
                    homeIconTooltip="Nadec"
                    menuButtonPressed="onMenuButtonPress"
                    showNotifications="true"
                    notificationsPressed="openNotification"
                    notificationsNumber="2"
                    id="idImage"
                >
                    <ff:profile>
                        <Avatar initials="UI" />
                    </ff:profile>
                    <ff:additionalContent>
                        <OverflowToolbarButton
                            press="openSettingsMenu"
                            tooltip="Admin Access"
                            icon="sap-icon://action-settings"
                        />
                    </ff:additionalContent>
                </ff:ShellBar>
            </tnt:header>
            <tnt:sideContent>
                <core:Fragment
                    fragmentName="nadec.frontend.fragment.SideNavigation"
                    type="XML"
                />
            </tnt:sideContent>
            <tnt:mainContents>
                <NavContainer id="app" />
            </tnt:mainContents>
        </tnt:ToolPage>
    </App>
</mvc:View>