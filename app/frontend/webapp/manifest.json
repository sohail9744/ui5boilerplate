{
  "_version": "1.65.0",
  "sap.app": {
    "id": "nadec.frontend",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.15.7",
      "toolsId": "31ce65d7-5b66-48f5-9e27-1eda4ca61a05"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/admin/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zshareholder-manage": {
          "semanticObject": "zshareholder",
          "action": "manage",
          "title": "{{flpTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.131.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.suite.ui.generic.template": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.ui.table": {},
        "sap.ushell": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "nadec.frontend.i18n.i18n"
        }
      },
      "navList": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/dashboardList.json"
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "nadec.frontend.view"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": ":?query:",
          "target": ["TagetHome"]
        },
        {
          "name": "RouteHistory",
          "pattern": "history",
          "target": ["TargetHistory"]
        },
        {
          "name": "RouteMyTask",
          "pattern": "mytask",
          "target": ["TargetMyTask"]
        }
      ],
      "targets": {
        "TagetHome": {
          "id": "View1",
          "name": "View1"
        },
        "TargetHistory": {
          "viewPath": "nadec.frontend.app.History",
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "History",
          "viewName": "Home"
        },
        "TargetMyTask": {
          "viewPath": "nadec.frontend.app.myTask",
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "myTask",
          "viewName": "Home"
        }
      }
    },
    "rootView": {
      "viewName": "nadec.frontend.view.App",
      "type": "XML",
      "id": "App"
    }
  }
}
